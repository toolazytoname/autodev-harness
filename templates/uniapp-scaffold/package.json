    "test:smoke": "UNI_AUTOMATOR_SKIP_RUNTIME=1 node tests/uni-automator/_smoke.spec.js"
  },
  "dependencies": {
    "@dcloudio/uni-app": "^3.0.0",
    "@dcloudio/uni-app-plus": "^3.0.0",
