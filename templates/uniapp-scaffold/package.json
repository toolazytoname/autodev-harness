{
  "name": "yuyue-uniapp",
  "version": "0.1.0",
  "description": "鱼跃 YuYue — 少儿游泳俱乐部成绩与晋级管理(uni-app + Vue 3 + 微信云开发)",
  "main": "src/main.js",
  "scripts": {
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:h5": "uni",
