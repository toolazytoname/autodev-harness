{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "鱼跃",
        "navigationBarBackgroundColor": "#FFFFFF",
        "navigationBarTextStyle": "black",
        "enablePullDownRefresh": false
      }
    },
    {
      "path": "pages/class-overview/class-overview",
      "style": {
        "navigationBarTitleText": "班级成绩总览",
        "navigationBarBackgroundColor": "#FFFFFF",
        "navigationBarTextStyle": "black"
      }
    },
    {
      "path": "pages/students/students",
      "style": {
        "navigationBarTitleText": "学员信息",
        "navigationBarBackgroundColor": "#FFFFFF",
        "navigationBarTextStyle": "black"
      }
    },
    {
      "path": "pages/students/student-detail",
      "style": {
        "navigationBarTitleText": "学员详情",
        "navigationBarBackgroundColor": "#FFFFFF",
        "navigationBarTextStyle": "black"
      }
    },
    {
      "path": "pages/profile/profile",
      "style": {
        "navigationBarTitleText": "我的",
        "navigationBarBackgroundColor": "#FFFFFF",
        "navigationBarTextStyle": "black"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "鱼跃",
    "navigationBarBackgroundColor": "#FFFFFF",
    "backgroundColor": "#F7FAFC"
  },
  "tabBar": {
    "color": "#9AA5B1",
    "selectedColor": "#5BB5D8",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/index/index",
        "iconPath": "static/tab/home.png",
        "selectedIconPath": "static/tab/home-active.png",
        "text": "首页"
      },
      {
        "pagePath": "pages/class-overview/class-overview",
        "iconPath": "static/tab/class.png",
        "selectedIconPath": "static/tab/class-active.png",
        "text": "成绩"
      },
      {
        "pagePath": "pages/students/students",
        "iconPath": "static/tab/students.png",
        "selectedIconPath": "static/tab/students-active.png",
        "text": "学员"
      },
      {
        "pagePath": "pages/profile/profile",
        "iconPath": "static/tab/me.png",
        "selectedIconPath": "static/tab/me-active.png",
        "text": "我的"
      }
    ]
  },
  "condition": {
    "current": 0,
    "list": [
      {
        "name": "首页",
        "path": "pages/index/index"
      }
    ]
  }
}